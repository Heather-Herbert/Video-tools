# video-tools configuration. Copy to .env and fill in what you need:
#
#     cp .env.example .env
#
# .env is gitignored. Never commit real keys.
# Real environment variables override this file, so systemd units and CI can
# set their own values without editing it.

# --- where episodes live ----------------------------------------------------
# One directory per episode slug. Needs room for proxies: budget roughly
# 3x the size of the raw camera file.
POLYCULE_EPISODES=/home/heather/episodes

# --- LLM backends -----------------------------------------------------------
# The chain is Claude CLI -> agy CLI -> DeepSeek -> OpenRouter, and it stops at
# the first one that answers. The CLI tools cost nothing, so the API keys below
# are only reached when neither CLI is installed or both fail.
#
# Nothing here is required if you have the `claude` or `agy` CLI on PATH.

DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Model overrides. Defaults are fine; change only if a model is retired.
#AGY_MODEL=gemini-3.5-flash-medium
#DEEPSEEK_MODEL=deepseek-chat
#OPENROUTER_MODEL=openrouter/auto

# --- speaker labels (optional) ----------------------------------------------
# pyannote needs a Hugging Face token and acceptance of the model's licence at
# https://hf.co/pyannote/speaker-diarization-3.1
# Without it the pipeline still runs, but name cards and per-speaker punch-ins
# are skipped and the segments are flagged for review.
HF_TOKEN=

# --- reusing a host machine's modules (optional) ----------------------------
# If this box also runs the Jennifer assistant, point these at its versions so
# there is one LLM chain and one Whisper setup to maintain. Leave blank on a
# fresh machine — the repo is self-contained without them.
LLM_BACKEND_PATH=
MEDIA_TRANSCRIBE_PATH=
